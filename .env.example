# Optional. Without a key, ActionPilot uses its deterministic demo planner.
LLM_API_KEY=

# Any provider with an OpenAI-compatible Chat Completions endpoint can be used.
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# The hosting platform supplies PORT in production.
PORT=3000
